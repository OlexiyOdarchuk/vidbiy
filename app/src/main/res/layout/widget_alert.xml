<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="8dp"
    android:paddingEnd="8dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_widget_place" />

        <TextView
            android:id="@+id/alert_place"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_sample_place"
            android:textColor="#A7B4CC"
            android:textSize="12sp" />

        <ImageView
            android:id="@+id/alert_refresh"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="@string/widget_refresh"
            android:padding="7dp"
            android:src="@drawable/ic_widget_refresh" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingEnd="6dp">

        <TextView
            android:id="@+id/alert_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:text="@string/widget_alert_sample"
            android:textColor="#3DD68C"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/alert_detail"
            android:text="@string/widget_sample_last"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="#F1F4FA"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/alert_footer"
        android:text="@string/widget_sample_updated"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#A7B4CC"
        android:textSize="11sp" />
</LinearLayout>
